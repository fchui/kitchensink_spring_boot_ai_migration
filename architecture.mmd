---
title: Kitchensink – High-Level Architecture (Spring Boot)
---
flowchart TB
    %% ---------- Clients ----------
    subgraph Clients["Clients"]
        Browser(["👤 People<br/>(web browser)"])
        ExtSys(["🔌 Other systems<br/>(CRM, mobile app, …)"])
    end

    %% ---------- Application ----------
    subgraph App["Spring Boot app – kitchensink.jar (embedded Tomcat, /kitchensink)"]
        direction TB

        subgraph Presentation["Presentation layer"]
            UI["Web UI<br/>templates/index.html (Thymeleaf)"]
            REST["REST API<br/>MemberResourceRESTService (@RestController)<br/>GET/POST /rest/members"]
        end

        Controller["MemberController (@Controller)<br/>form handling + messages"]

        subgraph Business["Business layer"]
            Service["MemberRegistration<br/>(@Service)"]
        end

        Event{{"Member registered<br/>(ApplicationEventPublisher)"}}

        subgraph Data["Data access layer"]
            Repo["MemberRepository<br/>(Spring Data MongoRepository)"]
        end

        Model["Member entity<br/>name · email · phone<br/>+ validation rules"]

        subgraph CrossCutting["Cross-cutting"]
            direction LR
            DI["Constructor injection<br/>auto-configuration"]
            I18N["MessageSource<br/>EN / ES / FR"]
        end
    end

    %% ---------- Persistence ----------
    subgraph Storage["Persistence"]
        Mongo["Spring Data MongoDB<br/>MemberIdGenerator (numeric ids)<br/>MemberDataInitializer (seed)"]
        DB[("MongoDB<br/>members (unique email index)<br/>counters")]
    end

    %% ---------- Build ----------
    subgraph Build["Build and run"]
        direction LR
        Maven["Maven build<br/>spring-boot-maven-plugin"]
        Jar["java -jar<br/>executable jar"]
    end

    %% ---------- Flows ----------
    Browser -->|HTTP| UI
    ExtSys -->|JSON over HTTP| REST

    UI --> Controller
    Controller -->|register + member list| Service
    REST -->|validate, register, list, lookup| Service

    Service -->|insert / find| Repo
    Service -.->|publishes| Event

    Repo -->|query| Mongo
    Mongo --- Model
    Mongo --> DB

    Maven -->|packages| Jar
    Jar -->|runs| App

